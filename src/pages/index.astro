---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero container">
				<div class="hero-copy">
					<p class="eyebrow">Ideas · Systems · Practice</p>
					<h1>把複雜的事，寫成可以實踐的知識。</h1>
					<p class="hero-intro">
						這裡收藏技術實作、工作方法與一路上的思考。保留脈絡，也整理出下一步能採取的行動。
					</p>
					<div class="hero-actions">
						<a class="primary-action" href="/blog">閱讀所有文章 <span aria-hidden="true">↗</span></a>
						<a class="text-action" href="/about">認識這個網站</a>
					</div>
				</div>
				<aside class="manifesto" aria-label="本站主題">
					<span class="manifesto-number">01</span>
					<div>
						<p class="manifesto-label">Currently exploring</p>
						<p class="manifesto-title">Technology × Workflow</p>
						<p class="manifesto-note">不追逐雜訊，只保留值得反覆閱讀的內容。</p>
					</div>
				</aside>
			</section>

			<section class="latest container" aria-labelledby="latest-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Latest writing</p>
						<h2 id="latest-title">近期文章</h2>
					</div>
					<a href="/blog">查看全部 <span aria-hidden="true">→</span></a>
				</div>

				<div class="post-list">
					{
						posts.map((post, index) => (
							<article class="post-row">
								<span class="post-index">{String(index + 1).padStart(2, '0')}</span>
								<div class="post-copy">
									<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
									<h3><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h3>
									{post.data.description && <p class="post-description">{post.data.description}</p>}
								</div>
								<a class="post-arrow" href={'/blog/' + post.id + '/'} aria-label={'閱讀：' + post.data.title}>↗</a>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.65fr);
		min-height: 650px;
		align-items: center;
		gap: clamp(3rem, 8vw, 8rem);
		padding-block: clamp(5rem, 10vw, 9rem);
	}

	.hero-copy h1 {
		max-width: 780px;
		font-size: clamp(3.4rem, 7vw, 6.3rem);
		line-height: 1.06;
	}

	.hero-intro {
		max-width: 620px;
		margin: 2rem 0 0;
		color: var(--muted);
		font-size: clamp(1.05rem, 1.5vw, 1.24rem);
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-top: 2.4rem;
	}

	.primary-action {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		padding: 0.82rem 1.15rem;
		background: var(--ink);
		color: #fff;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		transition: background 180ms ease, transform 180ms ease;
	}

	.primary-action:hover {
		background: var(--accent-dark);
		color: #fff;
		transform: translateY(-2px);
	}

	.text-action {
		font-size: 0.86rem;
		font-weight: 700;
		text-decoration: none;
	}

	.manifesto {
		position: relative;
		min-height: 330px;
		padding: 2rem;
		border: 1px solid var(--line-dark);
		background: rgba(251, 250, 246, 0.7);
		box-shadow: var(--shadow);
	}

	.manifesto::after {
		position: absolute;
		right: 1.2rem;
		bottom: 1.2rem;
		width: 3.5rem;
		height: 3.5rem;
		border-right: 1px solid var(--accent);
		border-bottom: 1px solid var(--accent);
		content: "";
	}

	.manifesto-number {
		display: block;
		margin-bottom: 6rem;
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 4.5rem;
		line-height: 0.8;
	}

	.manifesto-label {
		margin: 0 0 0.4rem;
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.manifesto-title {
		margin: 0 0 0.75rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1.5rem;
	}

	.manifesto-note {
		max-width: 15rem;
		margin: 0;
		color: var(--muted);
		font-size: 0.86rem;
		line-height: 1.65;
	}

	.latest {
		padding-block: clamp(5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.section-heading .eyebrow {
		margin-bottom: 0.9rem;
	}

	.section-heading > a {
		margin-bottom: 0.5rem;
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
	}

	.post-list {
		border-top: 1px solid var(--line-dark);
	}

	.post-row {
		display: grid;
		grid-template-columns: 70px minmax(0, 1fr) 44px;
		align-items: start;
		gap: 1.5rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--line);
	}

	.post-index,
	.post-date {
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.post-date {
		margin: 0 0 0.4rem;
	}

	.post-copy h3 a {
		text-decoration: none;
	}

	.post-description {
		max-width: 690px;
		margin: 0.65rem 0 0;
		color: var(--muted);
		font-size: 0.92rem;
	}

	.post-arrow {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid var(--line-dark);
		font-size: 1rem;
		text-decoration: none;
		transition: background 180ms ease, color 180ms ease;
	}

	.post-arrow:hover {
		background: var(--ink);
		color: #fff;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			gap: 4rem;
		}

		.manifesto {
			display: grid;
			grid-template-columns: auto 1fr;
			min-height: auto;
			align-items: end;
			gap: 2rem;
		}

		.manifesto-number {
			margin: 0;
		}
	}

	@media (max-width: 620px) {
		.hero {
			padding-block: 4.5rem;
		}

		.hero-copy h1 {
			font-size: clamp(3rem, 15vw, 4.5rem);
		}

		.hero-actions {
			align-items: flex-start;
			flex-direction: column;
		}

		.manifesto {
			grid-template-columns: 1fr;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 1rem;
		}

		.post-row {
			grid-template-columns: 36px minmax(0, 1fr);
			gap: 0.75rem;
		}

		.post-arrow {
			display: none;
		}
	}
</style>
