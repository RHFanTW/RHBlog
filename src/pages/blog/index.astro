---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={'所有文章｜' + SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="archive-hero container">
				<div>
					<p class="eyebrow">Archive</p>
					<h1>所有文章</h1>
				</div>
				<div class="archive-intro">
					<p>每一次整理，都是讓經驗變得更清晰。</p>
					<span>{String(posts.length).padStart(2, '0')} 篇公開文章</span>
				</div>
			</header>

			<section class="archive container" aria-label="文章列表">
				{
					posts.length > 0 ? (
						posts.map((post, index) => (
							<article class="archive-row">
								<div class="archive-index">{String(index + 1).padStart(2, '0')}</div>
								<div class="archive-meta">
									<span>{post.data.category ?? 'NOTE'}</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<div class="archive-copy">
									<h2><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h2>
									{post.data.description && <p>{post.data.description}</p>}
									{post.data.tags.length > 0 && (
										<ul class="tags" aria-label="標籤">
											{post.data.tags.map((tag) => <li>{tag}</li>)}
										</ul>
									)}
								</div>
								<a class="read-link" href={'/blog/' + post.id + '/'} aria-label={'閱讀：' + post.data.title}>
									<span>閱讀</span>
									<span aria-hidden="true">↗</span>
								</a>
							</article>
						))
					) : (
						<p class="empty-state">文章正在整理中，歡迎稍後再回來。</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive-hero {
		display: grid;
		grid-template-columns: 1.45fr 0.75fr;
		align-items: end;
		gap: 4rem;
		padding-block: clamp(5rem, 9vw, 8rem);
	}

	.archive-hero h1 {
		font-size: clamp(3.5rem, 8vw, 6.8rem);
	}

	.archive-intro {
		padding: 0 0 0.6rem 1.5rem;
		border-left: 1px solid var(--line-dark);
	}

	.archive-intro p {
		margin: 0 0 1.25rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1.25rem;
	}

	.archive-intro span {
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.archive {
		padding-bottom: clamp(6rem, 10vw, 10rem);
	}

	.archive-row {
		display: grid;
		grid-template-columns: 52px 150px minmax(0, 1fr) auto;
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--line);
	}

	.archive-row:last-child {
		border-bottom: 1px solid var(--line);
	}

	.archive-index {
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 1rem;
	}

	.archive-meta {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.archive-copy h2 {
		font-size: clamp(1.55rem, 3vw, 2.45rem);
	}

	.archive-copy h2 a {
		text-decoration: none;
	}

	.archive-copy > p {
		max-width: 650px;
		margin: 0.85rem 0 0;
		color: var(--muted);
		font-size: 0.92rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.68rem;
		line-height: 1.5;
	}

	.read-link {
		display: flex;
		align-items: center;
		align-self: center;
		gap: 0.6rem;
		font-size: 0.76rem;
		font-weight: 700;
		text-decoration: none;
	}

	.empty-state {
		padding: 4rem 0;
		border-top: 1px solid var(--line);
		color: var(--muted);
	}

	@media (max-width: 820px) {
		.archive-hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.archive-row {
			grid-template-columns: 42px minmax(0, 1fr) auto;
			gap: 1rem;
		}

		.archive-meta {
			grid-column: 2 / -1;
			grid-row: 1;
			flex-direction: row;
			gap: 0.75rem;
		}

		.archive-index {
			grid-column: 1;
			grid-row: 1 / span 2;
		}

		.archive-copy {
			grid-column: 2;
			grid-row: 2;
		}

		.read-link {
			grid-column: 3;
			grid-row: 2;
		}
	}

	@media (max-width: 520px) {
		.archive-row {
			grid-template-columns: 30px minmax(0, 1fr);
		}

		.archive-meta {
			grid-column: 2;
		}

		.archive-copy {
			grid-column: 2;
		}

		.read-link {
			display: none;
		}
	}
</style>
