---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import profilePortrait from '../assets/rh-profile.png';
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead
			title={'關於｜' + SITE_TITLE}
			description="RH Journal 是一個整理技術實作、工作方法與學習筆記的個人網站。"
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="about-hero container">
				<div class="about-number" aria-hidden="true">02</div>
				<div>
					<p class="eyebrow">About this journal</p>
					<h1>寫下來，讓經驗成為可以帶走的東西。</h1>
				</div>
			</header>

			<section class="about-body container">
				<aside class="about-profile">
					<div class="about-label">
						<span>RH Journal</span>
						<span>Est. 2026</span>
					</div>
					<figure class="profile-portrait">
						<Image
							src={profilePortrait}
							alt="RH Journal 作者個人照"
							width={440}
							quality="mid"
						/>
					</figure>
					<p class="profile-caption">
						RHFan 范潤華, mailto: <a href="mailto:rhfan.tw@gmail.com">rhfan.tw@gmail.com</a>
					</p>
				</aside>
				<div class="about-copy">
					<p class="lead">
						RH Journal 是一個用來整理思考與實作筆記的個人網站。這裡不只記錄結果，也保留過程中的判斷、取捨與修正。
					</p>
					<p>
						我相信真正有用的知識，不是收藏過的資訊，而是經過理解、驗證，最後能在需要時再次派上用場的方法。寫作讓模糊的直覺變得清楚，也讓零散的經驗形成系統。
					</p>

					<div class="focus-grid">
						<article>
							<span>01</span>
							<h2>技術實作</h2>
							<p>記錄工具、開發與自動化過程中，真正影響成果的細節。</p>
						</article>
						<article>
							<span>02</span>
							<h2>工作方法</h2>
							<p>拆解流程、決策與協作方式，尋找更穩定也更從容的節奏。</p>
						</article>
						<article>
							<span>03</span>
							<h2>持續學習</h2>
							<p>整理新知、反思與實驗，把學到的事轉化成自己的理解。</p>
						</article>
					</div>

					<div class="about-cta">
						<p>如果你也在意如何把事情做得更清楚、更有效率，歡迎從最新的文章開始。</p>
						<a href="/blog">前往文章列表 <span aria-hidden="true">→</span></a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-hero {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr);
		align-items: start;
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: clamp(5rem, 10vw, 9rem);
	}

	.about-number {
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: clamp(5rem, 10vw, 8rem);
		line-height: 0.8;
	}

	.about-hero h1 {
		max-width: 850px;
		font-size: clamp(3.2rem, 7vw, 6rem);
	}

	.about-body {
		display: grid;
		grid-template-columns: 220px minmax(0, 760px);
		justify-content: space-between;
		gap: 4rem;
		padding-block: clamp(5rem, 10vw, 9rem);
		border-top: 1px solid var(--line-dark);
	}

	.about-label {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.profile-portrait {
		aspect-ratio: 4 / 5;
		margin: 2.5rem 0 0;
		overflow: hidden;
		border: 1px solid var(--line-dark);
		background: var(--surface);
		box-shadow: var(--shadow);
	}

	.profile-portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 28% center;
	}

	.profile-caption {
		width: 100%;
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.67rem;
		letter-spacing: -0.02em;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.profile-caption a {
		text-decoration-color: var(--accent);
	}

	.about-copy > p {
		color: var(--muted);
	}

	.about-copy .lead {
		margin-bottom: 1.5rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: clamp(1.55rem, 3vw, 2.25rem);
		line-height: 1.55;
	}

	.focus-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		margin-top: 4rem;
		border: 1px solid var(--line);
		background: var(--line);
	}

	.focus-grid article {
		min-height: 245px;
		padding: 1.5rem;
		background: var(--surface);
	}

	.focus-grid span {
		display: block;
		margin-bottom: 3rem;
		color: var(--accent);
		font-family: var(--font-serif);
	}

	.focus-grid h2 {
		margin-bottom: 0.85rem;
		font-size: 1.35rem;
	}

	.focus-grid p {
		margin: 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.7;
	}

	.about-cta {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.about-cta p {
		max-width: 520px;
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.about-cta a {
		flex: 0 0 auto;
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration: none;
	}

	@media (max-width: 820px) {
		.about-hero {
			grid-template-columns: 1fr;
		}

		.about-body {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.about-label {
			flex-direction: row;
			justify-content: space-between;
		}

		.about-profile {
			display: grid;
			grid-template-columns: minmax(160px, 220px) minmax(0, 1fr);
			align-items: end;
			gap: 2rem;
		}

		.profile-portrait {
			grid-column: 1;
			grid-row: 1;
			margin: 0;
		}

		.about-label {
			grid-column: 2;
			grid-row: 1;
		}

		.profile-caption {
			grid-column: 1;
			grid-row: 2;
			margin-top: -1rem;
		}
	}

	@media (max-width: 650px) {
		.focus-grid {
			grid-template-columns: 1fr;
		}

		.focus-grid article {
			min-height: auto;
		}

		.focus-grid span {
			margin-bottom: 1.5rem;
		}

		.about-cta {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.about-profile {
			grid-template-columns: minmax(135px, 42vw) minmax(0, 1fr);
			gap: 1.25rem;
		}

		.about-label {
			flex-direction: column;
			justify-content: flex-end;
		}
	}
</style>
