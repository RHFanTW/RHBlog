---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="container" aria-label="主要導覽">
		<a class="brand" href="/" aria-label={SITE_TITLE + ' 首頁'}>
			<span class="brand-mark" aria-hidden="true">RH</span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<small>Ideas, systems & practice</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">首頁</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">關於</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 10;
		border-bottom: 1px solid var(--line);
		background: rgba(245, 243, 237, 0.94);
	}

	nav {
		display: flex;
		min-height: 88px;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--ink);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--ink);
	}

	.brand-mark {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid var(--ink);
		font-family: var(--font-serif);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.brand-copy {
		display: grid;
		gap: 0.08rem;
		line-height: 1.15;
	}

	.brand-copy strong {
		font-family: var(--font-serif);
		font-size: 1rem;
		letter-spacing: 0.04em;
	}

	.brand-copy small {
		color: var(--muted);
		font-size: 0.66rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: clamp(1.1rem, 3vw, 2.5rem);
	}

	.internal-links :global(a) {
		position: relative;
		padding: 0.8rem 0;
		color: var(--muted);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.internal-links :global(a::after) {
		position: absolute;
		right: 0;
		bottom: 0.45rem;
		left: 0;
		height: 1px;
		background: var(--accent);
		content: "";
		transform: scaleX(0);
		transition: transform 180ms ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--ink);
	}

	.internal-links :global(a:hover::after),
	.internal-links :global(a.active::after) {
		transform: scaleX(1);
	}

	@media (max-width: 620px) {
		nav {
			min-height: 76px;
			gap: 1rem;
		}

		.brand-mark {
			width: 38px;
			height: 38px;
		}

		.brand-copy small {
			display: none;
		}

		.internal-links {
			gap: 0.9rem;
		}

		.internal-links :global(a) {
			font-size: 0.76rem;
			letter-spacing: 0.04em;
		}
	}

	@media (max-width: 390px) {
		.brand-copy {
			display: none;
		}
	}
</style>
