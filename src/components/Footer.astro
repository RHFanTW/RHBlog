---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div>
			<p class="footer-title">{SITE_TITLE}</p>
			<p class="footer-description">{SITE_DESCRIPTION}</p>
		</div>
		<div class="footer-meta">
			<a href="/rss.xml">RSS 訂閱</a>
			<span>© {today.getFullYear()} RH. All rights reserved.</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: 3rem 0;
		border-top: 1px solid var(--line);
		background: var(--ink);
		color: #d8d8d0;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 3rem;
	}

	.footer-title {
		margin: 0 0 0.35rem;
		color: #fff;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		font-weight: 600;
	}

	.footer-description {
		max-width: 34rem;
		margin: 0;
		color: #9fa39c;
		font-size: 0.86rem;
	}

	.footer-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35rem;
		color: #9fa39c;
		font-size: 0.76rem;
		letter-spacing: 0.04em;
	}

	.footer-meta a {
		color: #ecece6;
		text-decoration: none;
	}

	.footer-meta a:hover {
		color: #fff;
	}

	@media (max-width: 680px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.footer-meta {
			align-items: flex-start;
		}
	}
</style>
